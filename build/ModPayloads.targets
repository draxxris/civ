<Project>
  <!-- Stages the shipped mods (build/Mods.props) next to a host that loads mods from its own output directory: the
       game, the tests and the tools all import this file. The base modules of Ariel.Rules are not mods: their manifests
       and data arrive under rules/ through the project reference. Only the small files go through MSBuild copy
       (dll/pdb/mod.json/data); the heavy art/ trees (~180MB) are symlinked, which File and Directory APIs follow, so a
       host or a test gets them at zero copy cost.

       Import at the end of the host project. Every host stages the main mods into mods/. Set StageOptionalMods to true
       for a host that also stages the optional mods into optional-mods/, as the game ships them, and LinkModArt to false
       for a host that never reads art. The mods themselves become build-order project references here, so a host never
       lists them. -->
  <Import Project="$(MSBuildThisFileDirectory)Mods.props" />

  <PropertyGroup>
    <_ArielModsSource>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../src/Mods'))</_ArielModsSource>
    <_ArielRulesSource>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../src/Ariel.Rules'))</_ArielRulesSource>
    <_ArielOptionalStaged Condition="'$(StageOptionalMods)' == 'true'">$(ArielOptionalMods)</_ArielOptionalStaged>
  </PropertyGroup>

  <!-- Build-order references only: a host never compiles against a mod. -->
  <ItemGroup>
    <_ArielStagedMod Include="$(ArielMainMods);$(_ArielOptionalStaged)" />
    <ProjectReference Include="@(_ArielStagedMod->'$(_ArielModsSource)/%(Identity)/Ariel.Mods.%(Identity).csproj')"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyModPayloads" AfterTargets="Build">
    <ItemGroup>
      <_MainMod Include="$(ArielMainMods)" />
      <_MainBin Include="$(_ArielModsSource)/%(_MainMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.dll" ModDir="%(_MainMod.Identity)" />
      <_MainBin Include="$(_ArielModsSource)/%(_MainMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.pdb" ModDir="%(_MainMod.Identity)" />
      <_MainMeta Include="$(_ArielModsSource)/%(_MainMod.Identity)/mod.json" ModDir="%(_MainMod.Identity)" />
      <_MainData Include="$(_ArielModsSource)/%(_MainMod.Identity)/data/**/*.json" ModDir="%(_MainMod.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainBin)" DestinationFiles="@(_MainBin->'$(OutDir)mods/%(ModDir)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MainMeta)" DestinationFiles="@(_MainMeta->'$(OutDir)mods/%(ModDir)/mod.json')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MainData)" DestinationFiles="@(_MainData->'$(OutDir)mods/%(ModDir)/data/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Mods the player can enable but that are off by default live in optional-mods/, as the game ships them. -->
  <Target Name="CopyOptionalModPayloads" AfterTargets="CopyModPayloads" Condition="'$(StageOptionalMods)' == 'true'">
    <ItemGroup>
      <_OptionalMod Include="$(ArielOptionalMods)" />
      <_OptionalBin Include="$(_ArielModsSource)/%(_OptionalMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.dll" ModDir="%(_OptionalMod.Identity)" />
      <_OptionalBin Include="$(_ArielModsSource)/%(_OptionalMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.pdb" ModDir="%(_OptionalMod.Identity)" />
      <_OptionalMeta Include="$(_ArielModsSource)/%(_OptionalMod.Identity)/mod.json" ModDir="%(_OptionalMod.Identity)" />
      <_OptionalData Include="$(_ArielModsSource)/%(_OptionalMod.Identity)/data/**/*.json" ModDir="%(_OptionalMod.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(_OptionalBin)" DestinationFiles="@(_OptionalBin->'$(OutDir)optional-mods/%(ModDir)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_OptionalMeta)" DestinationFiles="@(_OptionalMeta->'$(OutDir)optional-mods/%(ModDir)/mod.json')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_OptionalData)" DestinationFiles="@(_OptionalData->'$(OutDir)optional-mods/%(ModDir)/data/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Keep each staged folder to exactly its list, so a mod that moves between the lists, or leaves them, does not
       stay loadable from where an earlier build put it. -->
  <Target Name="PruneModPayloads" AfterTargets="CopyOptionalModPayloads">
    <PropertyGroup>
      <_StagedMainRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'mods'))</_StagedMainRoot>
      <_StagedOptionalRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutDir)', 'optional-mods'))</_StagedOptionalRoot>
    </PropertyGroup>
    <ItemGroup>
      <_StaleModDir Include="$([System.IO.Directory]::GetDirectories('$(_StagedMainRoot)'))" Condition="Exists('$(_StagedMainRoot)')" />
      <_StaleModDir Include="$([System.IO.Directory]::GetDirectories('$(_StagedOptionalRoot)'))" Condition="Exists('$(_StagedOptionalRoot)')" />
      <_KeptMod Include="$(ArielMainMods)" />
      <_KeptOptionalMod Include="$(_ArielOptionalStaged)" />
      <_StaleModDir Remove="@(_KeptMod->'$(_StagedMainRoot)%(Identity)')" />
      <_StaleModDir Remove="@(_KeptOptionalMod->'$(_StagedOptionalRoot)%(Identity)')" />
    </ItemGroup>
    <RemoveDir Directories="@(_StaleModDir)" />
  </Target>

  <!-- Base modules stage their manifests and data through the Ariel.Rules project reference; only their art is linked. -->
  <Target Name="LinkModArt" AfterTargets="PruneModPayloads" Condition="'$(LinkModArt)' != 'false'">
    <ItemGroup>
      <_ModuleWithArt Include="Foundation;World;Research;Economy;Cities;Military;Government;Peoples" />
    </ItemGroup>
    <!-- Batched once per module (no shell loop vars): rm any stale real art dir, then symlink source art/. -->
    <Exec Condition="'$(OS)' != 'Windows_NT' And Exists('$(_ArielRulesSource)/%(_ModuleWithArt.Identity)/art')" Command="rm -rf &quot;$([System.IO.Path]::GetFullPath('$(OutDir)rules/%(_ModuleWithArt.Identity)/art'))&quot; &amp;&amp; mkdir -p &quot;$([System.IO.Path]::GetFullPath('$(OutDir)rules/%(_ModuleWithArt.Identity)'))&quot; &amp;&amp; ln -sfn &quot;$(_ArielRulesSource)/%(_ModuleWithArt.Identity)/art&quot; &quot;$([System.IO.Path]::GetFullPath('$(OutDir)rules/%(_ModuleWithArt.Identity)/art'))&quot;" />
    <Exec Condition="'$(OS)' == 'Windows_NT' And Exists('$(_ArielRulesSource)/%(_ModuleWithArt.Identity)/art')" Command="rmdir /s /q &quot;$(OutDir)rules\%(_ModuleWithArt.Identity)\art&quot; 2&gt;nul &amp; mkdir &quot;$(OutDir)rules\%(_ModuleWithArt.Identity)&quot; 2&gt;nul &amp; mklink /D &quot;$(OutDir)rules\%(_ModuleWithArt.Identity)\art&quot; &quot;$(_ArielRulesSource)\%(_ModuleWithArt.Identity)\art&quot;" />
    <!-- A staged mod that ships art of its own (Corporations' headquarters and executives) gets the same link. -->
    <ItemGroup>
      <_StagedModWithArt Include="$(ArielMainMods)" Folder="mods" />
      <_StagedModWithArt Include="$(_ArielOptionalStaged)" Folder="optional-mods" />
    </ItemGroup>
    <Exec Condition="'$(OS)' != 'Windows_NT' And Exists('$(_ArielModsSource)/%(_StagedModWithArt.Identity)/art')" Command="rm -rf &quot;$([System.IO.Path]::GetFullPath('$(OutDir)%(_StagedModWithArt.Folder)/%(_StagedModWithArt.Identity)/art'))&quot; &amp;&amp; mkdir -p &quot;$([System.IO.Path]::GetFullPath('$(OutDir)%(_StagedModWithArt.Folder)/%(_StagedModWithArt.Identity)'))&quot; &amp;&amp; ln -sfn &quot;$(_ArielModsSource)/%(_StagedModWithArt.Identity)/art&quot; &quot;$([System.IO.Path]::GetFullPath('$(OutDir)%(_StagedModWithArt.Folder)/%(_StagedModWithArt.Identity)/art'))&quot;" />
    <Exec Condition="'$(OS)' == 'Windows_NT' And Exists('$(_ArielModsSource)/%(_StagedModWithArt.Identity)/art')" Command="rmdir /s /q &quot;$(OutDir)%(_StagedModWithArt.Folder)\%(_StagedModWithArt.Identity)\art&quot; 2&gt;nul &amp; mkdir &quot;$(OutDir)%(_StagedModWithArt.Folder)\%(_StagedModWithArt.Identity)&quot; 2&gt;nul &amp; mklink /D &quot;$(OutDir)%(_StagedModWithArt.Folder)\%(_StagedModWithArt.Identity)\art&quot; &quot;$(_ArielModsSource)\%(_StagedModWithArt.Identity)\art&quot;" />
  </Target>
</Project>
