<Project>
  <!-- Stages the mod build outputs next to a host that loads mods from its own output directory. Only the small files
       go through MSBuild copy (dll/pdb/mod.json/data); the heavy art/ trees (~180MB) are symlinked, which File and
       Directory APIs follow, so a host or a test gets them at zero copy cost.

       Import from a project two directories below the repository root (tests/Ariel.Mods.Tests,
       tools/Ariel.Benchmarks, tools/Ariel.Validate); every path below is relative to the importing project.
       Set ModPayloads to the mods the host loads, ModPayloadsOptional to mods it stages separately, and LinkModArt to
       false for a host that never reads art. -->
  <Target Name="CopyModPayloads" AfterTargets="Build" Condition="'$(ModPayloads)' != ''">
    <ItemGroup>
      <_MainMod Include="$(ModPayloads)" />
      <_MainBin Include="../../src/Mods/%(_MainMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.dll" ModDir="%(_MainMod.Identity)" />
      <_MainBin Include="../../src/Mods/%(_MainMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.pdb" ModDir="%(_MainMod.Identity)" />
      <_MainMeta Include="../../src/Mods/%(_MainMod.Identity)/mod.json" ModDir="%(_MainMod.Identity)" />
      <_MainData Include="../../src/Mods/%(_MainMod.Identity)/data/**/*.json" ModDir="%(_MainMod.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(_MainBin)" DestinationFiles="@(_MainBin->'$(OutDir)mods/%(ModDir)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MainMeta)" DestinationFiles="@(_MainMeta->'$(OutDir)mods/%(ModDir)/mod.json')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_MainData)" DestinationFiles="@(_MainData->'$(OutDir)mods/%(ModDir)/data/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Mods the host can enable but does not load on its own live in optional-mods/, as the game ships them. -->
  <Target Name="CopyOptionalModPayloads" AfterTargets="CopyModPayloads" Condition="'$(ModPayloadsOptional)' != ''">
    <ItemGroup>
      <_OptionalMod Include="$(ModPayloadsOptional)" />
      <_OptionalBin Include="../../src/Mods/%(_OptionalMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.dll" ModDir="%(_OptionalMod.Identity)" />
      <_OptionalBin Include="../../src/Mods/%(_OptionalMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.pdb" ModDir="%(_OptionalMod.Identity)" />
      <_OptionalMeta Include="../../src/Mods/%(_OptionalMod.Identity)/mod.json" ModDir="%(_OptionalMod.Identity)" />
      <_OptionalData Include="../../src/Mods/%(_OptionalMod.Identity)/data/**/*.json" ModDir="%(_OptionalMod.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(_OptionalBin)" DestinationFiles="@(_OptionalBin->'$(OutDir)optional-mods/%(ModDir)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_OptionalMeta)" DestinationFiles="@(_OptionalMeta->'$(OutDir)optional-mods/%(ModDir)/mod.json')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_OptionalData)" DestinationFiles="@(_OptionalData->'$(OutDir)optional-mods/%(ModDir)/data/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="LinkModArt" AfterTargets="CopyOptionalModPayloads" Condition="'$(ModPayloads)' != '' and '$(LinkModArt)' != 'false'">
    <ItemGroup>
      <_ModWithArt Include="Foundation;World;Research;Economy;Cities;Military;Government;Peoples" />
    </ItemGroup>
    <!-- Batched once per mod (no shell loop vars): rm any stale real art dir, then symlink source art/. -->
    <Exec Condition="'$(OS)' != 'Windows_NT' AND Exists('../../src/Mods/%(_ModWithArt.Identity)/art')" Command="rm -rf &quot;$([System.IO.Path]::GetFullPath('$(OutDir)mods/%(_ModWithArt.Identity)/art'))&quot; &amp;&amp; mkdir -p &quot;$([System.IO.Path]::GetFullPath('$(OutDir)mods/%(_ModWithArt.Identity)'))&quot; &amp;&amp; ln -sfn &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Mods/%(_ModWithArt.Identity)/art'))&quot; &quot;$([System.IO.Path]::GetFullPath('$(OutDir)mods/%(_ModWithArt.Identity)/art'))&quot;" />
    <Exec Condition="'$(OS)' == 'Windows_NT' AND Exists('../../src/Mods/%(_ModWithArt.Identity)/art')" Command="rmdir /s /q &quot;$(OutDir)mods\%(_ModWithArt.Identity)\art&quot; 2&gt;nul &amp; mkdir &quot;$(OutDir)mods\%(_ModWithArt.Identity)&quot; 2&gt;nul &amp; mklink /D &quot;$(OutDir)mods\%(_ModWithArt.Identity)\art&quot; &quot;$(MSBuildProjectDirectory)\..\..\src\Mods\%(_ModWithArt.Identity)\art&quot;" />
  </Target>
</Project>
