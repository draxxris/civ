<Project>
  <!-- The one list of shipped mods, by folder under src/Mods. build/ModPayloads.targets imports it, so every host that
       stages mods (the game, the tests and the tools) stages the same set.

       ArielMainMods load by default and stage into mods/. ArielOptionalMods stage into optional-mods/: the player can
       enable them, but they are off until chosen. ArielOptionalFeatureMods are the optional mods that add a feature;
       ArielAlternativeMods replace part of a base module (CardResearch replaces how research is chosen), so a host
       that turns the optional features on by default, such as the sync check, still leaves them out. -->
  <PropertyGroup>
    <ArielMainMods>GreatPeople;Trade;RangedCombat;AirCombat;Barbarians;Religion;GlobalWarming</ArielMainMods>
    <ArielOptionalFeatureMods>Votes;ProjectsVictory;Corporations;Espionage;Events;ScriptedWonders;Revolution</ArielOptionalFeatureMods>
    <ArielAlternativeMods>CardResearch</ArielAlternativeMods>
    <ArielOptionalMods>$(ArielOptionalFeatureMods);$(ArielAlternativeMods)</ArielOptionalMods>
  </PropertyGroup>
</Project>
