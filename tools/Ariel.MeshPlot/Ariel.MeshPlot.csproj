<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Ariel.Core/Ariel.Core.csproj" />
    <ProjectReference Include="../../src/Ariel.Rules/Ariel.Rules.csproj" />
    <ProjectReference Include="../../src/Ariel.Composition/Ariel.Composition.csproj" />
    <ProjectReference Include="../../src/Ariel.Client.Core/Ariel.Client.Core.csproj" />
    <ProjectReference Include="../../src/Mods/GreatPeople/Ariel.Mods.GreatPeople.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Trade/Ariel.Mods.Trade.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/RangedCombat/Ariel.Mods.RangedCombat.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Religion/Ariel.Mods.Religion.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- The same mod set the game loads, staged by build/ModPayloads.targets. The meshes are built from
       content and rules alone, so the heavy art/ trees are not linked. -->
  <PropertyGroup>
    <ModPayloads>GreatPeople;Trade;RangedCombat;Religion</ModPayloads>
    <LinkModArt>false</LinkModArt>
  </PropertyGroup>
  <Import Project="../../build/ModPayloads.targets" />
</Project>
