<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <!-- Reuse the workload fixtures without referencing the test assembly or xUnit. -->
    <Compile Include="../../tests/Ariel.Mods.Tests/GameFactory.cs" Link="GameFactory.cs" />
    <ProjectReference Include="../../src/Ariel.Core/Ariel.Core.csproj" />
    <ProjectReference Include="../../src/Ariel.Client.Core/Ariel.Client.Core.csproj" />
    <ProjectReference Include="../../src/Mods/Foundation/Ariel.Mods.Foundation.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/World/Ariel.Mods.World.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Research/Ariel.Mods.Research.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Economy/Ariel.Mods.Economy.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Cities/Ariel.Mods.Cities.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Military/Ariel.Mods.Military.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Government/Ariel.Mods.Government.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Peoples/Ariel.Mods.Peoples.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Religion/Ariel.Mods.Religion.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Ai/Ariel.Mods.Ai.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/GreatPeople/Ariel.Mods.GreatPeople.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Trade/Ariel.Mods.Trade.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Only small files go through MSBuild copy (dll/pdb/mod.json/data). Heavy art/ (~180MB) is symlinked by
       LinkModArt below, matching the test and Godot projects. -->
  <Target Name="CopyModPayloads" AfterTargets="Build">
    <ItemGroup>
      <BenchMod Include="Foundation;World;Research;Economy;Cities;Military;Government;Peoples;Ai;Religion;GreatPeople;Trade" />
      <BenchBin Include="../../src/Mods/%(BenchMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.dll" ModDir="%(BenchMod.Identity)" />
      <BenchBin Include="../../src/Mods/%(BenchMod.Identity)/bin/$(Configuration)/net10.0/Ariel.Mods.*.pdb" ModDir="%(BenchMod.Identity)" />
      <BenchMeta Include="../../src/Mods/%(BenchMod.Identity)/mod.json" ModDir="%(BenchMod.Identity)" />
      <BenchData Include="../../src/Mods/%(BenchMod.Identity)/data/**/*.json" ModDir="%(BenchMod.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(BenchBin)" DestinationFiles="@(BenchBin->'$(OutDir)mods/%(ModDir)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BenchMeta)" DestinationFiles="@(BenchMeta->'$(OutDir)mods/%(ModDir)/mod.json')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BenchData)" DestinationFiles="@(BenchData->'$(OutDir)mods/%(ModDir)/data/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="LinkModArt" AfterTargets="CopyModPayloads">
    <ItemGroup>
      <ModWithArt Include="Foundation;World;Research;Economy;Cities;Military;Government;Peoples" />
    </ItemGroup>
    <!-- Batched once per mod (no shell loop vars): rm any stale real art dir, then symlink source art/. -->
    <Exec Condition="'$(OS)' != 'Windows_NT' AND Exists('../../src/Mods/%(ModWithArt.Identity)/art')" Command="rm -rf &quot;$([System.IO.Path]::GetFullPath('$(OutDir)mods/%(ModWithArt.Identity)/art'))&quot; &amp;&amp; mkdir -p &quot;$([System.IO.Path]::GetFullPath('$(OutDir)mods/%(ModWithArt.Identity)'))&quot; &amp;&amp; ln -sfn &quot;$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../../src/Mods/%(ModWithArt.Identity)/art'))&quot; &quot;$([System.IO.Path]::GetFullPath('$(OutDir)mods/%(ModWithArt.Identity)/art'))&quot;" />
    <Exec Condition="'$(OS)' == 'Windows_NT' AND Exists('../../src/Mods/%(ModWithArt.Identity)/art')" Command="rmdir /s /q &quot;$(OutDir)mods\%(ModWithArt.Identity)\art&quot; 2&gt;nul &amp; mkdir &quot;$(OutDir)mods\%(ModWithArt.Identity)&quot; 2&gt;nul &amp; mklink /D &quot;$(OutDir)mods\%(ModWithArt.Identity)\art&quot; &quot;$(MSBuildProjectDirectory)\..\..\src\Mods\%(ModWithArt.Identity)\art&quot;" />
  </Target>
</Project>
