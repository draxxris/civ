<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <!-- Reuse the game fixtures without referencing the test assembly or xUnit. -->
    <Compile Include="../../tests/Ariel.Mods.Tests/GameFactory.cs" Link="GameFactory.cs" />
    <ProjectReference Include="../../src/Ariel.Core/Ariel.Core.csproj" />
    <ProjectReference Include="../../src/Ariel.Rules/Ariel.Rules.csproj" />
    <ProjectReference Include="../../src/Ariel.Client.Core/Ariel.Client.Core.csproj" />
    <ProjectReference Include="../../src/Ariel.Net/Ariel.Net.csproj" />
    <ProjectReference Include="../../src/Mods/Ai/Ariel.Mods.Ai.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/GreatPeople/Ariel.Mods.GreatPeople.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Trade/Ariel.Mods.Trade.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Diplomacy/Ariel.Mods.Diplomacy.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/ProjectsVictory/Ariel.Mods.ProjectsVictory.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Corporations/Ariel.Mods.Corporations.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Espionage/Ariel.Mods.Espionage.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Events/Ariel.Mods.Events.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/ScriptedWonders/Ariel.Mods.ScriptedWonders.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Revolution/Ariel.Mods.Revolution.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/CardResearch/Ariel.Mods.CardResearch.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/TechTree/Ariel.Mods.TechTree.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <!-- Every shipped mod, main and optional, staged as the game ships them. Sync checks never render. -->
  <PropertyGroup>
    <ModPayloads>Ai;GreatPeople;Trade</ModPayloads>
    <ModPayloadsOptional>Diplomacy;ProjectsVictory;Corporations;Espionage;Events;ScriptedWonders;Revolution;CardResearch;TechTree</ModPayloadsOptional>
    <LinkModArt>false</LinkModArt>
  </PropertyGroup>
  <Import Project="../../build/ModPayloads.targets" />
</Project>
