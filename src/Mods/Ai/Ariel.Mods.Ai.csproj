<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../Ariel.Core/Ariel.Core.csproj" />
    <!-- The host supplies Ariel.Rules and its staged rules/ payload; a mod never carries its own copy. -->
    <ProjectReference Include="../../Ariel.Rules/Ariel.Rules.csproj" Private="false" />
    <!-- Optional consumer of the Corporations API. Its copy ships in the Ai folder, so the API types resolve when the
         Corporations mod is absent; the loader shares one copy across the process either way. -->
    <ProjectReference Include="../Corporations/Api/Ariel.Mods.Corporations.Api.csproj" />
    <None Update="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
