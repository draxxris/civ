<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../Ariel.Core/Ariel.Core.csproj" />
    <!-- The host supplies Ariel.Rules and its staged rules/ payload; a mod never carries its own copy. -->
    <ProjectReference Include="../../Ariel.Rules/Ariel.Rules.csproj" Private="false" />
    <!-- The host supplies the computer player too; this mod contributes a planner, production wishes and valuers. -->
    <ProjectReference Include="../../Ariel.Ai/Ariel.Ai.csproj" Private="false" />
    <!-- The API this mod publishes ships beside it in the mod folder; mod.json names it. -->
    <ProjectReference Include="Api/Ariel.Mods.Religion.Api.csproj" />
    <!-- The great person each religious wonder's and shrine's points count towards is the Great People mod's
         attachment; this mod registers those rows about its own buildings. Copied into this folder, so the API resolves
         when that mod is absent. -->
    <ProjectReference Include="../GreatPeople/Api/Ariel.Mods.GreatPeople.Api.csproj" />
    <None Update="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data/**/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
