<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="../../Ariel.Core/Ariel.Core.csproj" />
    <!-- The host supplies Ariel.Rules and its staged rules/ payload; a mod never carries its own copy. -->
    <ProjectReference Include="../../Ariel.Rules/Ariel.Rules.csproj" Private="false" />
    <!-- The API this mod publishes ships beside it in the mod folder; mod.json names it. -->
    <ProjectReference Include="Api/Ariel.Mods.GreatPeople.Api.csproj" />
    <!-- Trade missions price themselves from the Trade mod's routes when it is loaded. Copied into this folder, so
         the API resolves when that mod is absent. -->
    <ProjectReference Include="../Trade/Api/Ariel.Mods.Trade.Api.csproj" />
    <!-- The host supplies the computer player too; this mod contributes a planner to it. -->
    <ProjectReference Include="../../Ariel.Ai/Ariel.Ai.csproj" Private="false" />
    <!-- Prophets build shrines when the Religion mod is loaded. Copied into this folder, so
         the API resolves when that mod is absent. -->
    <ProjectReference Include="../Religion/Api/Ariel.Mods.Religion.Api.csproj" />
    <None Update="mod.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
