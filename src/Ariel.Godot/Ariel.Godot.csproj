<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!--
    Godot 4 .NET front end. Not part of Ariel.slnx so the headless game builds and tests without the engine.
    Build:  dotnet build src/Ariel.Godot
    Run: godot-mono, with the project path set to src/Ariel.Godot
    The base modules are linked in through Ariel.Rules and Ariel.Ai (composed by Ariel.Composition), which stage their
    manifests and data to <output>/rules/<Name>;
    the build symlinks their art/ there. Mods are plain DLLs loaded by Ariel.Core; they never contain Godot types. The
    build copies the main mods (assembly, mod.json, data) to <output>/mods/<Name>, which load by default, and the
    optional mods to <output>/optional-mods/<Name>, which the player enables in the mod manager.
    ARIEL_MODS adds a root with higher per-ID priority than user-installed and bundled mods.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Ariel.Godot</AssemblyName>
    <RootNamespace>Ariel.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ariel.Core\Ariel.Core.csproj" />
    <ProjectReference Include="..\Ariel.Rules\Ariel.Rules.csproj" />
    <ProjectReference Include="..\Ariel.Composition\Ariel.Composition.csproj" />
    <ProjectReference Include="..\Ariel.Client.Core\Ariel.Client.Core.csproj" />
    <Using Include="Ariel.Presentation" />
  </ItemGroup>
  <!-- The shipped mods: main mods to <output>/mods, optional mods to <output>/optional-mods, base-module art linked
       under <output>/rules. The list is build/Mods.props. -->
  <PropertyGroup>
    <StageOptionalMods>true</StageOptionalMods>
  </PropertyGroup>
  <Import Project="../../build/ModPayloads.targets" />
</Project>
