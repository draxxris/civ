<Project Sdk="Godot.NET.Sdk/4.4.1">
  <!--
    Godot 4 .NET front end. Not part of Civ.slnx so the headless game builds and tests without the engine.
    Build:  dotnet build src/Civ.Godot
    Run:    godot with the project path set to src/Civ.Godot (Godot 4.4 .NET)
    Mods are plain DLLs loaded by Civ.Core; they never contain Godot types.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AssemblyName>Civ.Godot</AssemblyName>
    <RootNamespace>Civ.Client</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Civ.Core\Civ.Core.csproj" />
    <ProjectReference Include="..\Civ.BaseGame\Civ.BaseGame.csproj" />
    <ProjectReference Include="..\Civ.Client.Core\Civ.Client.Core.csproj" />
    <!-- Bundled mods: their mods/<id> folders (mod.json + data) are copied next to the game, where Main looks for mods. -->
    <ProjectReference Include="..\Civ.Religion\Civ.Religion.csproj" />
    <ProjectReference Include="..\Civ.Guilds\Civ.Guilds.csproj" />
    <ProjectReference Include="..\Civ.Corporations\Civ.Corporations.csproj" />
  </ItemGroup>
  <Target Name="CopyModAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)Civ.Religion.dll" DestinationFolder="$(OutDir)mods/religion" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)Civ.Guilds.dll" DestinationFolder="$(OutDir)mods/guilds" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)Civ.Corporations.dll" DestinationFolder="$(OutDir)mods/corporations" SkipUnchangedFiles="true" />
  </Target>
</Project>
