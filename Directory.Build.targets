<Project>


  <PropertyGroup Condition="'$(IsTestProject)' == 'true' and '$(MSBuildProjectName)' != 'Civ.TestMetricsLogger'">
    <VSTestLogger Condition="'$(VSTestLogger)' == ''">CivTestMetrics</VSTestLogger>
    <VSTestTestAdapterPath Condition="'$(VSTestTestAdapterPath)' == ''">$(TargetDir)</VSTestTestAdapterPath>
  </PropertyGroup>
</Project>
