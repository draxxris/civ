<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\tools\Ariel.TestMetricsLogger\Ariel.TestMetricsLogger.csproj" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <ProjectReference Include="../../src/Ariel.Core/Ariel.Core.csproj" />
    <ProjectReference Include="../../src/Ariel.Rules/Ariel.Rules.csproj" />
    <ProjectReference Include="../../src/Ariel.Composition/Ariel.Composition.csproj" />
    <ProjectReference Include="../../src/Ariel.Client.Core/Ariel.Client.Core.csproj" />
    <ProjectReference Include="../../src/Mods/CardResearch/Ariel.Mods.CardResearch.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/TechTree/Ariel.Mods.TechTree.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/GreatPeople/Ariel.Mods.GreatPeople.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Trade/Ariel.Mods.Trade.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/RangedCombat/Ariel.Mods.RangedCombat.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Diplomacy/Ariel.Mods.Diplomacy.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/ProjectsVictory/Ariel.Mods.ProjectsVictory.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Corporations/Ariel.Mods.Corporations.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Espionage/Ariel.Mods.Espionage.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Events/Ariel.Mods.Events.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/ScriptedWonders/Ariel.Mods.ScriptedWonders.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/Mods/Revolution/Ariel.Mods.Revolution.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../tools/Ariel.Benchmarks/AiEvaluation/*.cs" Link="AiEvaluation/%(Filename)%(Extension)" />
  </ItemGroup>
  <!-- Every shipped mod, staged into the test output by build/ModPayloads.targets. LinkModArt stays on:
       TerrainPaletteTests needs World/art/terrain and ScatterPlannerTests needs World/art/scatter. -->
  <PropertyGroup>
    <ModPayloads>GreatPeople;Trade;RangedCombat</ModPayloads>
    <ModPayloadsOptional>Diplomacy;ProjectsVictory;Corporations;Espionage;Events;ScriptedWonders;Revolution;CardResearch;TechTree</ModPayloadsOptional>
  </PropertyGroup>
  <Import Project="../../build/ModPayloads.targets" />

  <!-- Test mods that prove one mod can consume another's published API (ModApiTests), that a mod can contribute
       a planner, production wishes and valuers to the computer player (AiPlannerTests, AiValuerTests), and that a mod can add a kind of memory
       (RelationsTests). This host must not reference their API, so each mod folder in
       test-mods/ carries its own copy and the loader has to share one. -->
  <ItemGroup>
    <ProjectReference Include="../TestMods/ApiProvider/Ariel.TestMods.ApiProvider.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestMods/ApiConsumer/Ariel.TestMods.ApiConsumer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestMods/AiPlanner/Ariel.TestMods.AiPlanner.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestMods/MemoryKind/Ariel.TestMods.MemoryKind.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestMods/ProductionWish/Ariel.TestMods.ProductionWish.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestMods/CivicExtension/Ariel.TestMods.CivicExtension.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../TestMods/ResourceVariety/Ariel.TestMods.ResourceVariety.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyTestMods" AfterTargets="Build">
    <ItemGroup>
      <_TestMod Include="ApiProvider;ApiConsumer;AiPlanner;MemoryKind;ProductionWish;CivicExtension;ResourceVariety" />
      <_TestModFile Include="../TestMods/%(_TestMod.Identity)/bin/$(Configuration)/net10.0/Ariel.TestMods.*.dll" ModDir="%(_TestMod.Identity)" />
      <_TestModFile Include="../TestMods/%(_TestMod.Identity)/mod.json" ModDir="%(_TestMod.Identity)" />
      <_TestModData Include="../TestMods/%(_TestMod.Identity)/data/*.json" ModDir="%(_TestMod.Identity)" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestModFile)" DestinationFiles="@(_TestModFile->'$(OutDir)test-mods/%(ModDir)/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TestModData)" DestinationFiles="@(_TestModData->'$(OutDir)test-mods/%(ModDir)/data/%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
