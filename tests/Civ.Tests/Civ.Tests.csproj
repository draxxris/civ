<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Civ.Core\Civ.Core.csproj" />
    <ProjectReference Include="..\..\src\Civ.Net\Civ.Net.csproj" />
    <ProjectReference Include="..\..\src\Civ.BaseGame\Civ.BaseGame.csproj" />
    <ProjectReference Include="..\..\src\Civ.Client.Core\Civ.Client.Core.csproj" />
    <!-- Built so their mods/<id> folders (mod.json + data) land in the test output; the tests load them like a player would. -->
    <ProjectReference Include="..\..\src\Civ.Religion\Civ.Religion.csproj" />
    <ProjectReference Include="..\..\src\Civ.Guilds\Civ.Guilds.csproj" />
    <ProjectReference Include="..\..\src\Civ.Corporations\Civ.Corporations.csproj" />
  </ItemGroup>
  <Target Name="CopyModAssemblies" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)Civ.Religion.dll" DestinationFolder="$(OutDir)mods/religion" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)Civ.Guilds.dll" DestinationFolder="$(OutDir)mods/guilds" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(OutDir)Civ.Corporations.dll" DestinationFolder="$(OutDir)mods/corporations" SkipUnchangedFiles="true" />
  </Target>
</Project>
