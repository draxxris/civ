<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><IsPackable>false</IsPackable></PropertyGroup>
  <ItemGroup>
    <!-- The host supplies the kernel and the base rules, the screen contract among them. The mod references no client
         and no UI toolkit: it only describes what it shows. -->
    <ProjectReference Include="../../../src/Ariel.Core/Ariel.Core.csproj" Private="false" />
    <ProjectReference Include="../../../src/Ariel.Rules/Ariel.Rules.csproj" Private="false" />
    <None Update="mod.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="data/*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
